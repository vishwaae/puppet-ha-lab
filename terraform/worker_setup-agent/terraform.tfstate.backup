            "user_data": "#!/bin/bash\n# cloud-init first boot: install post_script.sh as a systemd unit and start it.\n# No secrets here — only the SSM parameter NAME.\nmkdir -p /etc/puppetlabs\ncat \u003e /etc/puppetlabs/bootstrap.env \u003c\u003cENV\nSSM_PARAM=/puppetlab/foreman/api_token\nAWS_REGION=us-east-1\nENV\necho \"\" | base64 -d \u003e /usr/local/bin/post_script.sh\nchmod 755 /usr/local/bin/post_script.sh\ncat \u003e /etc/systemd/system/post_script.service \u003c\u003cUNIT\n[Unit]\nDescription=Zero-touch Puppet bootstrap\nAfter=network-online.target\nWants=network-online.target\n[Service]\nType=oneshot\nEnvironmentFile=/etc/puppetlabs/bootstrap.env\nExecStart=/usr/local/bin/post_script.sh\n[Install]\nWantedBy=multi-user.target\nUNIT\nsystemctl daemon-reload\nsystemctl enable --now post_script.service\n",
            "user_data_base64": null,
            "user_data_replace_on_change": true,
            "volume_tags": null,
